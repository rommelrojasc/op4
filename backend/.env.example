# IB Gateway Configuration
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
IB_READONLY=True
IB_ACCOUNT=

# Auto-trader (set to True to enable background auto-trading)
AUTO_TRADE_ENABLED=False

# Redis Configuration
REDIS_URL=redis://localhost:6379

# GexBot Classic GEX (used by Strategy 14 — Gamma Zero).
# Get a key at gexbot.com → API. Required when strategy14.gexSource is "gexbot".
# Without this, the dispatcher will fall back to the IB-derived GEX.
GEXBOT_API_KEY=

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=Trading Platform

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
